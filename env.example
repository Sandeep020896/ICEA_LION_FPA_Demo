# Demo login
DEMO_PASSWORD=replace-me
SESSION_TOKEN=any-long-random-string

# Shared secret: the Channels app must send the same value (x-ingest-secret)
INGEST_SECRET=shared-secret-also-set-in-channels

# Storage. Attach Upstash Redis from the Vercel Marketplace and these are set for you.
# Without them LitePAS keeps data in memory (fine for StackBlitz; resets on restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Start with a few demo policies when storage is empty (1 = yes)
SEED_DEMO=1

# Spark (for downloading Spark's own API call log for a journey)
SPARK_BASE_URL=https://excel.uat.jp.coherent.global
SPARK_TENANT=actuarial
SPARK_FOLDER=ICEA LION FPA Demo
SPARK_QUOTE_SERVICE=ILG FPA - Quotation
SPARK_API_KEY=replace-me

# Public URL of the Channels app (for links back)
CHANNELS_URL=
